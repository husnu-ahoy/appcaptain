NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Mapbox token (for map components)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
# Supabase (customer auth) — same project as apps/captain, values from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key (public). Empty: no widget, forms work as before.
# The API checks it with TURNSTILE_SECRET_KEY; Supabase Auth checks sign-in/sign-up/reset
# once "CAPTCHA protection" is on (Authentication > Bot and Abuse Protection).
# Local testing: 1x00000000000000000000AA always passes, 2x00000000000000000000AB always fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
